import tkinter as tk
from tkinter import messagebox
import random
import string

class PasswordGenerator:
    def __init__(self, root):
        self.root = root
        self.root.title("Password Generator")
        self.root.geometry("400x400")
        
        # Title
        tk.Label(root, text="🔐 Password Generator", font=("Arial", 18, "bold"), 
                 bg="#4CAF50", fg="white").pack(fill="x", pady=10)
        
        # Password Length
        tk.Label(root, text="Password Length:", font=("Arial", 12)).pack(pady=5)
        self.length_var = tk.IntVar(value=12)
        self.length_spinbox = tk.Spinbox(root, from_=4, to_=50, 
                                          textvariable=self.length_var, width=10, font=("Arial", 12))
        self.length_spinbox.pack()
        
        # Complexity Options
        tk.Label(root, text="Include:", font=("Arial", 12)).pack(pady=10)
        
        self.include_letters = tk.Checkbutton(value=True)
        tk.Checkbutton(root, text="✓ Letters (a-z, A-Z)", variable=self.include_letters).pack(anchor="w", padx=20)
        
        self.include_digits = tk.Checkbutton(root, text="✓ Digits (0-9)", variable=self.include_digits)
        self.include_digits = tk.BooleanVar(value=True)
        tk.Checkbutton(root, text="✓ Digits (0-9)", variable=self.include_digits).pack(anchor="w", padx=20)
        
        self.include_symbols = tk.BooleanVar(value=True)
        tk.Checkbutton(root, text="✓ Symbols (!@#$)", variable=self.include_symbols).pack(anchor="w", padx=20)
        
        # Generate Button
        tk.Button(root, text="🔑 Generate Password", command=self.generate_password, 
                  bg="#2196F3", fg="white", font=("Arial", 12, "bold"), 
                  padx=30, pady=10).pack(pady=20)
        
        # Result Frame
        result_frame = tk.Frame(root, bg="#f0f0f0", bd=1, relief="sunken", padx=10, pady=10)
        result_frame.pack(fill="x", padx=20, pady=10)
        
        tk.Label(result_frame, text="Generated Password:", font=("Arial", 10), fg="#666").pack()
        self.result_label = tk.Label(result_frame, text="", font=("Arial", 14, "bold"), 
                                      fg="#333", bg="#f0f0f0", wraplength=300)
        self.result_label.pack(pady=5)
        
        # Copy Button
        tk.Button(result_frame, text="📋 Copy to Clipboard", command=self.copy_password, 
                  bg="#FF9800", fg="white", font=("Arial", 9)).pack()
    
    def generate_password(self):
        try:
            # Get length
            length = self.length_spinbox.get()
            length = int(length)
            
            if length < 4:
                messagebox.showwarning("Warning", "Password length should be at least 4!")
                return
            
            # Build character set
            char_set = ""
            
            if self.include_letters.get():
                char_set += string.ascii_letters  # a-z, A-Z
            
            if self.include_digits.get():
                char_set += string.digits  # 0-9
            
            if self.include_symbols.get():
                char_set += string.punctuation  # !@#$%^&*
            
            if not char_set:
                messagebox.showwarning("Warning", "Please select at least one option!")
                return
            
            # Generate random password
            password = ''.join(random.choice(char_set) for _ in range(length))
            
            # Display password
            self.result_label.config(text=password)
        
        except:
            messagebox.showerror("Error", "Something went wrong!")
    
    def copy_password(self):
        password = self.result_label.text()
        if password:
            self.root.clipboard_clear()
            self.root.clipboard_append(password)
            messagebox.showinfo("Success", "Password copied to clipboard!")
        else:
            messagebox.showwarning("Warning", "No password to copy!")


# Corrected class variables
PasswordGenerator.include_letters = tk.BooleanVar(value=True)
PasswordGenerator.include_digits = tk.BooleanVar(value=True)
PasswordGenerator.include_symbols = tk.BooleanVar(value=True)

# Run the app
root = tk.Tk()
app = PasswordGenerator(root)
root.mainloop()

import tkinter as tk
from tkinter import messagebox

class Calculator:
    def __init__(self, root):
        self.root = root
        self.root.title("Simple Calculator")
        self.root.geometry("300x350")
        
        # Title
        tk.Label(root, text="🧮 Calculator", font=("Arial", 18, "bold")).pack(pady=10)
        
        # Number 1
        tk.Label(root, text="Enter Number 1:").pack()
        self.num1_entry = tk.Entry(root, width=20)
        self.num1_entry.pack(pady=5)
        
        # Number 2
        tk.Label(root, text="Enter Number 2:").pack()
        self.num2_entry = tk.Entry(root, width=20)
        self.num2_entry.pack(pady=5)
        
        # Operation choice
        tk.Label(root, text="Choose Operation:").pack()
        self.operation_var = tk.StringVar(value="+")
        ops = ["+", "-", "*", "/"]
        for op in ops:
            tk.Radiobutton(root, text=f"  {op}", variable=self.operation_var, 
                          value=op, font=("Arial", 12)).pack(anchor="w", padx=20)
        
        # Calculate button
        tk.Button(root, text="Calculate", command=self.calculate, 
                  bg="#4CAF50", fg="white", font=("Arial", 12, "bold"), 
                  padx=30, pady=10).pack(pady=20)
        
        # Result display
        self.result_label = tk.Label(root, text="Result: ", font=("Arial", 14), fg="#2196F3")
        self.result_label.pack()
    
    def calculate(self):
        try:
            # Get numbers
            num1 = float(self.num1_entry.get())
            num2 = float(self.num2_entry.get())
            operation = self.operation_var.get()
            
            # Perform calculation
            if operation == "+":
                result = num1 + num2
            elif operation == "-":
                result = num1 - num2
            elif operation == "*":
                result = num1 * num2
            elif operation == "/":
                if num2 == 0:
                    messagebox.showerror("Error", "Cannot divide by zero!")
                    return
                result = num1 / num2
            
            # Display result
            self.result_label.config(text=f"Result: {result}")
        
        except ValueError:
            messagebox.showwarning("Warning", "Please enter valid numbers!")


# Run the app
root = tk.Tk()
app = Calculator(root)
root.mainloop()

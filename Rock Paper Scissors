import tkinter as tk
from tkinter import messagebox
import random

class RockPaperScissors:
    def __init__(self, root):
        self.root = root
        self.root.title("Rock Paper Scissors")
        self.root.geometry("450x500")
        
        # Score variables
        self.user_score = 0
        self.computer_score = 0
        
        # Choices
        self.choices = ["rock", "paper", "scissors"]
        self.icons = {"rock": "🪨", "paper": "📄", "scissors": "🗃️"}
        
        # Title
        tk.Label(root, text="🎮 Rock Paper Scissors", font=("Arial", 18, "bold"), 
                 bg="#4CAF50", fg="white").pack(fill="x", pady=10)
        
        # Instructions
        instruction_frame = tk.Frame(root, bg="#f0f0f0", padx=10, pady=10)
        instruction_frame.pack(fill="x", padx=10, pady=5)
        
        tk.Label(instruction_frame, text="Rules:", font=("Arial", 11, "bold")).pack()
        tk.Label(instruction_frame, text="• Rock beats Scissors 🪨 beats 🗃️", font=("Arial", 10)).pack(anchor="w")
        tk.Label(instruction_frame, text="• Scissors beats Paper 🗃️ beats 📄", font=("Arial", 10)).pack(anchor="w")
        tk.Label(instruction_frame, text="• Paper beats Rock 📄 beats 🪨", font=("Arial", 10)).pack(anchor="w")
        
        # Score Board
        score_frame = tk.Frame(root, bg="#2196F3", padx=20, pady=10)
        score_frame.pack(fill="x", padx=10, pady=10)
        
        tk.Label(score_frame, text=f"User: {self.user_score}", font=("Arial", 14, "bold"), 
                 fg="white").pack(side="left", padx=20)
        tk.Label(score_frame, text=f"Computer: {self.computer_score}", font=("Arial", 14, "bold"), 
                 fg="white").pack(side="right", padx=20)
        
        # User Choice Buttons
        choice_frame = tk.Frame(root, padx=20, pady=15)
        choice_frame.pack()
        
        tk.Label(choice_frame, text="Choose Your Weapon:", font=("Arial", 12, "bold")).pack(pady=10)
        
        tk.Button(choice_frame, text="🪨 Rock", command=lambda: self.play("rock"), 
                  bg="#8B4513", fg="white", font=("Arial", 12, "bold"), width=10, height=2).grid(row=0, column=0, padx=10)
        tk.Button(choice_frame, text="📄 Paper", command=lambda: self.play("paper"), 
                  bg="#FFD700", fg="black", font=("Arial", 12, "bold"), width=10, height=2).grid(row=0, column=1, padx=10)
        tk.Button(choice_frame, text="🗃️ Scissors", command=lambda: self.play("scissors"), 
                  bg="#C0C0C0", fg="black", font=("Arial", 12, "bold"), width=10, height=2).grid(row=0, column=2, padx=10)
        
        # Result Display
        result_frame = tk.Frame(root, bg="#fff3e0", bd=1, relief="sunken", padx=15, pady=15)
        result_frame.pack(fill="x", padx=10, pady=15)
        
        self.user_choice_label = tk.Label(result_frame, text="Your Choice: ", font=("Arial", 12), fg="#666")
        self.user_choice_label.pack()
        
        self.computer_choice_label = tk.Label(result_frame, text="Computer: ", font=("Arial", 12), fg="#666")
        self.computer_choice_label.pack(pady=5)
        
        self.result_label = tk.Label(result_frame, text="", font=("Arial", 16, "bold"), fg="#333")
        self.result_label.pack(pady=10)
        
        # Reset Button
        tk.Button(root, text="🔄 Reset Scores", command=self.reset_scores, 
                  bg="#f44336", fg="white", font=("Arial", 10, "bold"), padx=20, pady=8).pack(pady=5)
    
    def play(self, user_choice):
        # Computer makes random choice
        computer_choice = random.choice(self.choices)
        
        # Determine winner
        result = self.determine_winner(user_choice, computer_choice)
        
        # Update scores
        if result == "win":
            self.user_score += 1
            result_text = "🎉 YOU WIN! 🎉"
            result_color = "#4CAF50"
        elif result == "lose":
            self.computer_score += 1
            result_text = "😢 YOU LOSE! 😢"
            result_color = "#f44336"
        else:
            result_text = "🤝 IT'S A TIE! 🤝"
            result_color = "#FF9800"
        
        # Display results
        self.user_choice_label.config(text=f"Your Choice: {self.icons[user_choice]} {user_choice.upper()}")
        self.computer_choice_label.config(text=f"Computer: {self.icons[computer_choice]} {computer_choice.upper()}")
        self.result_label.config(text=result_text, fg=result_color)
        
        # Update score board
        self.update_scoreboard()
    
    def determine_winner(self, user, computer):
        if user == computer:
            return "tie"
        elif (user == "rock" and computer == "scissors") or \
             (user == "scissors" and computer == "paper") or \
             (user == "paper" and computer == "rock"):
            return "win"
        else:
            return "lose"
    
    def update_scoreboard(self):
        # Find and update score labels
        for widget in self.root.winfo_children():
            if isinstance(widget, tk.Frame) and widget.cget("bg") == "#2196F3":
                for label in widget.winfo_children():
                    if label.cget("text").startswith("User:"):
                        label.config(text=f"User: {self.user_score}")
                    elif label.cget("text").startswith("Computer:"):
                        label.config(text=f"Computer: {self.computer_score}")
    
    def reset_scores(self):
        self.user_score = 0
        self.computer_score = 0
        self.user_choice_label.config(text="Your Choice: ")
        self.computer_choice_label.config(text="Computer: ")
        self.result_label.config(text="", fg="#333")
        self.update_scoreboard()
        messagebox.showinfo("Reset", "Scores have been reset!")


# Run the game
root = tk.Tk()
app = RockPaperScissors(root)
root.mainloop()
